# Server-side only. Copy this file to .env.local; do not commit .env.local.
GEMINI_API_KEY=
# Override with a structured-output-capable model available to your API key.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
HOST=127.0.0.1
PORT=3001
# Used only by the standalone server / API adapter for cross-origin requests.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
